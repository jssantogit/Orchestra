{
  "schema": "orchestra.runtime-manifest.v1",
  "runtime": "codex",
  "version": "1.4.2",
  "sourceRoots": [
    "core",
    "providers/codex",
    "runtimes/codex",
    "runtime",
    "schemas"
  ],
  "managedAssets": [
    {
      "type": "file",
      "source": "runtimes/codex/.codex/config.toml",
      "output": ".codex/config.toml"
    },
    {
      "type": "file",
      "source": "runtimes/codex/.codex/hooks.json",
      "output": ".codex/hooks.json"
    },
    {
      "type": "tree",
      "source": "runtimes/codex/.codex/agents",
      "output": ".codex/agents"
    },
    {
      "type": "tree",
      "source": "runtimes/codex/.codex/astra-orchestra",
      "output": ".codex/astra-orchestra",
      "exclude": [
        "core/**",
        "provider/**",
        "runtime/**"
      ]
    },
    {
      "type": "tree",
      "source": "core",
      "output": ".codex/astra-orchestra/core"
    },
    {
      "type": "tree",
      "source": "schemas",
      "output": ".codex/astra-orchestra/core/schemas"
    },
    {
      "type": "tree",
      "source": "providers/codex",
      "output": ".codex/astra-orchestra/provider/codex",
      "exclude": [
        "delegation-executor.mjs"
      ]
    },
    {
      "type": "file",
      "source": "runtime/project-runtime-manager.mjs",
      "output": ".codex/astra-orchestra/runtime/project-runtime-manager.mjs"
    },
    {
      "type": "file",
      "source": "runtime/project-state-ignore.mjs",
      "output": ".codex/astra-orchestra/runtime/project-state-ignore.mjs"
    },
    {
      "type": "file",
      "source": "runtime/manifest-loader.mjs",
      "output": ".codex/astra-orchestra/runtime/manifest-loader.mjs"
    },
    {
      "type": "file",
      "source": "runtime/manifests/codex.json",
      "output": ".codex/astra-orchestra/runtime/manifests/codex.json"
    }
  ],
  "preservedProjectPaths": [
    ".codex/orchestra-state",
    ".codex/orchestra-telemetry",
    ".codex/orchestra-artifacts",
    ".codex/orchestra-semantic",
    ".codex/runtime-management",
    ".orchestra/state"
  ],
  "generatedInputs": [
    "core",
    "schemas",
    "providers/codex",
    "runtime/project-runtime-manager.mjs",
    "runtime/project-state-ignore.mjs",
    "runtime/manifest-loader.mjs",
    "runtime/manifests/codex.json"
  ],
  "entrypoints": [
    ".codex/config.toml",
    ".codex/hooks.json",
    ".codex/astra-orchestra/routing-policy.mjs",
    ".codex/astra-orchestra/session-hook.mjs",
    ".codex/astra-orchestra/session-post-tool-hook.mjs",
    ".codex/astra-orchestra/codex-runtime-cli.mjs",
    ".codex/astra-orchestra/provider/codex/project-runtime-manager.mjs"
  ],
  "healthChecks": [
    "schema-freshness",
    "runtime-core-freshness",
    "provider-firewall",
    "contamination"
  ]
}
