{
  "policy_id": "policy-0348de0c5e833dfad3ae430236c5ca83a4748012311072ee39240a42efdb0740",
  "schema": "orchestra.exploration-policy.v1",
  "base_policy": "static-policy-v1",
  "description": "Declarative static baseline policy for Orchestra Dream Layer (Milestones D-K)",
  "rules": [
    {
      "id": "worker-tier-post-investigation",
      "decision_type": "WORKER_TIER",
      "priority": 100,
      "when": {
        "post_investigation": true
      },
      "choose": "FLASH_HIGH",
      "description": "Post-investigation tasks require high worker tier"
    },
    {
      "id": "worker-tier-test-execution",
      "decision_type": "WORKER_TIER",
      "priority": 96,
      "when": {
        "task_action": [
          "TEST"
        ],
        "complexity": [
          "NORMAL",
          "DIFFICULT",
          "EXPERIMENTAL"
        ]
      },
      "choose": "FLASH_MEDIUM",
      "description": "Non-simple test execution routes to medium worker tier"
    },
    {
      "id": "worker-tier-high-complexity",
      "decision_type": "WORKER_TIER",
      "priority": 95,
      "when": {
        "complexity": [
          "DIFFICULT",
          "EXPERIMENTAL",
          "INTEGRATION"
        ]
      },
      "choose": "FLASH_HIGH",
      "description": "Difficult, experimental, and integration tasks require high worker tier"
    },
    {
      "id": "worker-tier-docs-domain",
      "decision_type": "WORKER_TIER",
      "priority": 90,
      "when": {
        "task_domain": [
          "DOCS"
        ]
      },
      "choose": "FLASH_LOW",
      "description": "Documentation tasks route to lightweight low worker tier"
    },
    {
      "id": "worker-tier-simple-mechanical",
      "decision_type": "WORKER_TIER",
      "priority": 90,
      "when": {
        "complexity": [
          "SIMPLE",
          "MECHANICAL"
        ]
      },
      "choose": "FLASH_LOW",
      "description": "Simple and mechanical tasks route to lightweight low worker tier"
    },
    {
      "id": "worker-tier-normal",
      "decision_type": "WORKER_TIER",
      "priority": 80,
      "when": {
        "complexity": [
          "NORMAL"
        ]
      },
      "choose": "FLASH_MEDIUM",
      "description": "Standard complexity tasks route to medium worker tier"
    },
    {
      "id": "worker-tier-default-fallback",
      "decision_type": "WORKER_TIER",
      "priority": 50,
      "when": {},
      "choose": "FLASH_MEDIUM",
      "description": "Default fallback worker tier is medium"
    },
    {
      "id": "investigation-strategy-default",
      "decision_type": "INVESTIGATION_STRATEGY",
      "priority": 80,
      "when": {
        "task_action": [
          "IMPLEMENT"
        ],
        "post_investigation": false
      },
      "choose": "IMPLEMENT_DIRECT",
      "description": "Standard clean implementation defaults to direct implementation"
    },
    {
      "id": "investigation-strategy-fallback",
      "decision_type": "INVESTIGATION_STRATEGY",
      "priority": 50,
      "when": {},
      "choose": "IMPLEMENT_DIRECT",
      "description": "Default investigation strategy is direct implementation"
    },
    {
      "id": "retry-failed-test",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "FAILED_TEST"
        ]
      },
      "choose": "RETRY_SAME",
      "description": "Failed test retry defaults to retry same worker"
    },
    {
      "id": "retry-incomplete-implementation",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "INCOMPLETE_IMPLEMENTATION"
        ]
      },
      "choose": "RETRY_SAME",
      "description": "Incomplete implementation defaults to retry same worker"
    },
    {
      "id": "retry-missing-context",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "MISSING_CONTEXT"
        ]
      },
      "choose": "INVESTIGATE_FIRST",
      "description": "Missing context retry requires investigation first"
    },
    {
      "id": "retry-misinterpreted-requirement",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "MISINTERPRETED_REQUIREMENT"
        ]
      },
      "choose": "REPLAN",
      "description": "Misinterpreted requirement requires replan"
    },
    {
      "id": "retry-scope-gap",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "SCOPE_GAP"
        ]
      },
      "choose": "REPLAN",
      "description": "Scope gap requires replan"
    },
    {
      "id": "retry-integration-failure",
      "decision_type": "RETRY_ACTION",
      "priority": 80,
      "when": {
        "retry_reason": [
          "INTEGRATION_FAILURE"
        ]
      },
      "choose": "ESCALATE_WORKER",
      "description": "Integration failure escalates worker"
    },
    {
      "id": "exploration-branching-budgeted",
      "decision_type": "EXPLORATION_BRANCHING",
      "priority": 80,
      "when": {
        "exploration_branches_remaining": {
          "min": 1,
          "max": 3
        }
      },
      "choose": "OPEN_BRANCH",
      "description": "Open another isolated branch while static exploration budget remains"
    },
    {
      "id": "exploration-branching-exhausted",
      "decision_type": "EXPLORATION_BRANCHING",
      "priority": 90,
      "when": {
        "exploration_branches_remaining": 0
      },
      "choose": "NO_NEW_BRANCH",
      "description": "Do not open branches after the static budget is exhausted"
    },
    {
      "id": "parallelism-conservative-default",
      "decision_type": "PARALLELISM",
      "priority": 50,
      "when": {},
      "choose": "SERIAL",
      "description": "Full exploration remains serial unless a promoted policy proves bounded parallelism"
    },
    {
      "id": "prune-falsified-branch",
      "decision_type": "PRUNE_BRANCH",
      "priority": 90,
      "when": {
        "branch_feedback_status": [
          "FALSIFIED"
        ]
      },
      "choose": "PRUNE_BRANCH",
      "description": "Prune a branch after factual feedback falsifies its hypothesis"
    },
    {
      "id": "prune-invalid-branch",
      "decision_type": "PRUNE_BRANCH",
      "priority": 95,
      "when": {
        "branch_invalid": true
      },
      "choose": "PRUNE_BRANCH",
      "description": "Prune a branch after runtime marks it invalid"
    },
    {
      "id": "prune-default-keep",
      "decision_type": "PRUNE_BRANCH",
      "priority": 50,
      "when": {},
      "choose": "KEEP_BRANCH",
      "description": "Keep factual branches absent a deterministic prune reason"
    },
    {
      "id": "stopping-budgeted",
      "decision_type": "STOPPING",
      "priority": 80,
      "when": {
        "exploration_branches_remaining": {
          "min": 1,
          "max": 3
        }
      },
      "choose": "CONTINUE_EXPLORATION",
      "description": "Continue isolated exploration while static branch budget remains"
    },
    {
      "id": "stopping-exhausted",
      "decision_type": "STOPPING",
      "priority": 90,
      "when": {
        "exploration_branches_remaining": 0
      },
      "choose": "STOP_EXPLORATION",
      "description": "Stop exploration when the static branch budget is exhausted"
    }
  ]
}
