{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.runtime-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime",
    "version",
    "sourceRoots",
    "managedAssets",
    "preservedProjectPaths",
    "generatedInputs",
    "entrypoints",
    "healthChecks"
  ],
  "properties": {
    "schema": { "const": "orchestra.runtime-manifest.v1" },
    "runtime": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "managedAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/managedAsset" }
    },
    "preservedProjectPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "generatedInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "healthChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "managedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "output"],
      "properties": {
        "type": { "enum": ["file", "tree", "symlink"] },
        "source": { "$ref": "#/$defs/relativePath" },
        "output": { "$ref": "#/$defs/relativePath" },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
