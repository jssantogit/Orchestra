{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.runtime-event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eventType", "timestamp", "actor"],
  "properties": {
    "schema": { "const": "orchestra.runtime-event.v1" },
    "eventType": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "taskId": { "type": "string" },
    "candidateGeneration": { "type": "integer", "minimum": 0 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sessionIdHash"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "sessionIdHash": { "type": "string", "minLength": 1 }
      }
    },
    "details": { "type": "object", "additionalProperties": true }
  }
}
