{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.implementation-packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "taskId", "candidateGeneration", "goal", "direction", "anchors", "scope", "permissions", "validation", "failurePolicy"],
  "properties": {
    "schema": { "const": "orchestra.implementation-packet.v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "candidateGeneration": { "type": "integer", "minimum": 0 },
    "goal": { "type": "string", "minLength": 1 },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "preserve"],
      "properties": {
        "cause": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "preserve": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "testHint": { "type": "string", "minLength": 1 },
          "exactText": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["symbol"] },
          { "required": ["file"] },
          { "required": ["testHint"] },
          { "required": ["exactText"] }
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAreas", "forbidden"],
      "properties": {
        "allowedAreas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "tests", "sideEffects"],
      "properties": {
        "discovery": { "enum": ["NONE", "DIRECTED", "INVESTIGATIVE"] },
        "tests": { "enum": ["READ_ONLY", "MODIFY_AUTHORIZED_TARGETS"] },
        "sideEffects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfCaused", "unrelatedOrUncertain"],
      "properties": {
        "selfCaused": { "const": "REPAIR" },
        "unrelatedOrUncertain": { "const": "RETURN_TO_CONTROL" }
      }
    }
  }
}
