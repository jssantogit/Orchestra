{
  "description": "Orchestra Codex root-session provenance and Work Lease authority.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/astra-orchestra/session-hook.mjs\"",
            "commandWindows": "$root = (& git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.codex/astra-orchestra/session-hook.mjs')",
            "timeout": 10,
            "statusMessage": "Checking Orchestra session authority",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/astra-orchestra/session-hook.mjs\"",
            "commandWindows": "$root = (& git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.codex/astra-orchestra/session-hook.mjs')",
            "timeout": 10,
            "statusMessage": "Checking Orchestra session authority"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/astra-orchestra/session-post-tool-hook.mjs\"",
            "commandWindows": "$root = (& git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.codex/astra-orchestra/session-post-tool-hook.mjs')",
            "timeout": 10,
            "statusMessage": "Releasing Orchestra workspace writer lease"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/astra-orchestra/session-hook.mjs\"",
            "commandWindows": "$root = (& git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.codex/astra-orchestra/session-hook.mjs')",
            "timeout": 10,
            "statusMessage": "Checking Orchestra session authority"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^terra-audit-lead$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/astra-orchestra/session-hook.mjs\"",
            "commandWindows": "$root = (& git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.codex/astra-orchestra/session-hook.mjs')",
            "timeout": 10,
            "statusMessage": "Binding bounded Terra audit identity",
            "additionalContextLimit": 700
          }
        ]
      }
    ]
  }
}
