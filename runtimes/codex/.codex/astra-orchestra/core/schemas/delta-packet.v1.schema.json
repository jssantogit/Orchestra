{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.delta-packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "taskId", "parentCandidateId", "workspaceId", "parentHeadSha", "baseCandidateGeneration", "candidateGeneration", "direction", "discovery", "confirmedFinding", "correctionArea", "revalidation"],
  "properties": {
    "schema": { "const": "orchestra.delta-packet.v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "parentCandidateId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "parentHeadSha": { "type": ["string", "null"] },
    "baseCandidateGeneration": { "type": "integer", "minimum": 0 },
    "candidateGeneration": { "type": "integer", "minimum": 1 },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "preserve"],
      "properties": {
        "cause": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "preserve": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "discovery": { "enum": ["NONE", "DIRECTED"] },
    "confirmedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "location", "issue"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "issue": { "type": "string", "minLength": 1 }
      }
    },
    "correctionArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAreas"],
      "properties": {
        "allowedAreas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "revalidation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
