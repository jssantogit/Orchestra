{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.delegation-request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "delegationId", "taskId", "source", "target", "purpose", "packet", "authority", "workspace", "limits"],
  "properties": {
    "schema": { "const": "orchestra.delegation-request.v2" },
    "delegationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "actorIdHash"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorIdHash": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "logicalRole"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "logicalRole": { "const": "IMPLEMENTER" }
      }
    },
    "purpose": { "const": "IMPLEMENTATION" },
    "packet": { "$ref": "orchestra.implementation-packet.v1" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "mutation", "network", "mayDelegate"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["LOCAL_READ", "PROCESS_EXEC", "WORKSPACE_EDIT"] }
        },
        "mutation": { "const": "WORKSPACE_ONLY" },
        "network": { "const": "FORBIDDEN" },
        "mayDelegate": { "const": false }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFingerprint", "sourceRevision", "isolation", "mutationScope"],
      "properties": {
        "sourceFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
        "isolation": { "const": "EPHEMERAL_CLONE" },
        "mutationScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedPaths", "forbiddenPaths"],
          "properties": {
            "allowedPaths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "forbiddenPaths": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxOutputBytes", "delegationDepth"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "delegationDepth": { "const": 1 }
      }
    }
  }
}
