{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.parallel-implementation-group.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groupId", "taskId", "generation", "source", "sourceRevision", "sourceFingerprint", "canonicalGitFingerprint", "members"],
  "properties": {
    "schema": { "const": "orchestra.parallel-implementation-group.v1" },
    "groupId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "generation": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "actorIdHash"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorIdHash": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sourceFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "canonicalGitFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "targetProvider", "packet", "mutationScope"],
        "properties": {
          "memberId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "targetProvider": { "type": "string", "minLength": 1, "maxLength": 128 },
          "packet": { "$ref": "orchestra.implementation-packet.v1" },
          "mutationScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowedPaths", "forbiddenPaths"],
            "properties": {
              "allowedPaths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
              },
              "forbiddenPaths": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        }
      }
    }
  }
}
