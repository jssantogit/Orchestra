{
  "scope-enforcer": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-tool-enforce.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "telemetry-logger": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/post-tool-telemetry.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "guard-rails": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/pre-invocation-guard.mjs",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-guard.mjs",
        "timeout": 10
      }
    ]
  },
  "exploration-budget-guard": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node hooks/post-invocation-exploration-guard.mjs",
        "timeout": 10
      }
    ]
  }
}
