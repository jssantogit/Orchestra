    "test:jev": "node --test tests/jev/jev-contract.test.mjs tests/jev/jev-shadow.test.mjs tests/jev/future-use-oracle.test.mjs tests/jev/turn-economy-jev.test.mjs tests/jev/turn-economy-metrics.test.mjs",
