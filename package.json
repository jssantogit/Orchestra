    "dream:shadow": "node runtimes/antigravity/.agents/dream/shadow-cli.mjs",
    "dream:canary": "node runtimes/antigravity/.agents/dream/canary-cli.mjs",
    "test:evidence": "node --test tests/evidence/first-class-evidence.test.mjs tests/evidence/cross-agent-evidence.test.mjs tests/evidence/evidence-observability.test.mjs tests/evidence/evidence-provider-watch.test.mjs",
    "project:runtime": "node scripts/orchestra-project.mjs",
    "test:mechanical": "node --test tests/mechanical/mechanical-fast-path.test.mjs",
    "test:feedback": "node --test tests/feedback/feedback-plane.test.mjs",
